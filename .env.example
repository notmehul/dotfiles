# ~/.config/.env  — single source for API keys/secrets.
# Copy this file to `.env` (gitignored) and fill in real values:
#     cp .env.example .env
# It is sourced by zsh/zshrc so CLI tools inherit these vars.

export CONTEXT7_API_KEY=""   # https://context7.com  → codex MCP (context7)
export TYPMO_API_KEY=""       # typmo.com            → codex MCP (typmo-spec)
export NOTION_API_KEY=""      # Notion integration token → gemini MCP (notion)
