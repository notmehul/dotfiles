# API keys / secrets (gitignored, see ~/.config/.env.example)
[ -f ~/.config/.env ] && source ~/.config/.env

#aliases
alias ls='eza -lah'
alias colorscript="$HOME/Dev/Shell-Color-Scripts/colorscript.sh"
alias ..='cd ..'
alias ...='cd ../..'
alias python='python3'

# pretty stuf on opening
[ -x ~/colorbars ] && ~/colorbars

# starship prompt
eval "$(starship init zsh)"

MAC_SDK_PATH=/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk
CMAKE_OSX_SYSROOT=$MAC_SDK_PATH
CMAKE_OSX_DEPLOYMENT_TARGET=13.3

# node is provided by Homebrew (single source); nvm removed.
export PATH="$HOME/.local/bin:$PATH"

# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# LSP for claude code
ENABLE_LSP_TOOL=1

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# completions + autosuggestions (fish-like)
fpath=(/opt/homebrew/share/zsh-completions /opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit -u   # -u: trust Homebrew's group-writable share dir
zstyle ':completion:*' menu select                        # arrow-key menu
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # case-insensitive
[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# modern CLI tools (guarded so a missing tool never breaks the shell)
command -v bat   >/dev/null && { alias cat='bat --style=plain --paging=never'; export MANPAGER="sh -c 'col -bx | bat -l man -p'"; }
command -v duf   >/dev/null && alias df='duf'
command -v fzf   >/dev/null && source <(fzf --zsh)          # Ctrl-T files, Alt-C dirs
command -v atuin >/dev/null && eval "$(atuin init zsh)"     # Ctrl-R history (loads after fzf)

# zoxide: replaces `cd` so it auto-learns dirs; `cd <partial>` jumps, `cdi` = fzf picker
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# syntax highlighting — must be sourced last
[ -f /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ] && source /opt/homebrew/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# cmux: open URLs in the embedded browser
export BROWSER="cmux browser open"

# cmux: ensure agents can always find the socket
export CMUX_SOCKET_PATH="$HOME/.config/cmux/cmux.sock"
