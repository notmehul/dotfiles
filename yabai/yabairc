#!/usr/bin/env sh

# Scripting addition needs passwordless sudo for `yabai --load-sa`:
# https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
yabai -m signal --add label=dock_restart event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# Only settings that differ from yabai's defaults, plus mouse_follows_focus,
# which is pinned off deliberately to stop the cursor warping onto popups.
yabai -m config \
    layout bsp \
    split_ratio 0.60 \
    top_padding 5 \
    bottom_padding 5 \
    left_padding 5 \
    right_padding 5 \
    window_gap 5 \
    external_bar all:39:0 \
    focus_follows_mouse autofocus \
    mouse_follows_focus off \
    window_zoom_persist off \
    window_opacity on \
    normal_window_opacity 0.5

yabai -m rule --add label=unmanaged_apps app="^(System Settings|System Information|Activity Monitor|FaceTime|Screen Sharing|Calculator|Stickies|TinkerTool|Progressive Downloader|Transmission|Airflow|Picture in Picture)$" manage=off

# Arc/Dia PiP windows report as AXSystemDialog under the browser app, not
# "Picture in Picture", so the rule above misses them.
yabai -m rule --add label=browser_pip app="^(Arc|Dia)$" subrole="AXSystemDialog" manage=off

# The Codex dictation overlay is a sticky standard window titled "Dictation";
# tiled, it landed on every space. Match the title to leave the main window managed.
yabai -m rule --add label=codex_dictation app="^Codex$" title="^Dictation$" manage=off

# Wispr Flow's dictation overlay is a roleless, unresizable window that appears
# and vanishes while dictating. yabai tiled it, leaving a phantom BSP leaf that
# kept windows half-width after moving their neighbour off the space. The
# overlay has no role or title to match on, so the whole app goes unmanaged.
yabai -m rule --add label=wispr_flow app="^Wispr Flow$" manage=off

# Keep sketchybar's space strips in sync.
for event in window_created window_destroyed window_minimized window_deminimized; do
    yabai -m signal --add label="$event" event="$event" action="sketchybar --trigger window_change"
done
yabai -m signal --add label=space_created event=space_created action="sketchybar --trigger space_change"
yabai -m signal --add label=space_destroyed event=space_destroyed action="sketchybar --trigger space_change"

borders active_color=0xffe1e3e4 inactive_color=0xff494d64 width=2.0
